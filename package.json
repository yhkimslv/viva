{
  "name": "viva",
  "version": "0.3.0-beta.1",
  "description": "VIVA — Visual Interface for Version Assistance",
  "author": "Sean Lee",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node --check out/main/index.js && node --check out/preload/index.cjs",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "test": "vitest run",
    "package": "npm run build && electron-builder",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "chokidar": "^6.0.0",
    "electron-store": "^12.0.0",
    "simple-git": "^4.0.2",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.2",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "jsdom": "^29.1.1",
    "playwright": "1.64.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "app-builder-lib": {
      "@electron/get": {
        "global-agent": "^4.1.3"
      }
    }
  }
}
